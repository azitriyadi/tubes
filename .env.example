# EcoRecycle Database & Security Configuration Template
# Salin file ini menjadi '.env' dan sesuaikan nilainya dengan server Anda.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ecorecycle

# Key untuk tanda tangan token HMAC SHA-256 (Ganti dengan string random yang panjang)
JWT_SECRET=MasukkanSecretKeyHmacSha256YangSangatRahasiaDiSini
